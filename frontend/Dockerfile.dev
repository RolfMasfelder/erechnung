# Development Dockerfile für Vue.js Frontend
# Use Node.js 24 LTS - Active LTS, EOL April 2030
FROM node:26-alpine

WORKDIR /app

# Package-Manager optimieren
RUN npm config set registry https://registry.npmjs.org/

# Dependencies installieren (wird gecacht wenn package.json unverändert)
COPY package*.json ./
RUN npm install

# App-Code kopieren
COPY . .

# Port für Vite Dev-Server
EXPOSE 5173

# Dev-Server starten mit Hot Reload
CMD ["npm", "run", "dev"]
